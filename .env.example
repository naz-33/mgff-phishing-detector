# ZanderEtAlFishing Phase 2 Configuration
# Path to Google OAuth Client Secrets JSON file (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials/credentials.json

# Path where the authorized OAuth user token will be saved
GMAIL_TOKEN_PATH=credentials/token.json

# Email polling interval in seconds (default: 60)
POLLING_INTERVAL_SECONDS=60

# SQLite database file path for email classification results
DATABASE_PATH=zander_email_monitor.db

# Maximum number of email IDs to fetch per page from Gmail API
GMAIL_MAX_RESULTS_PER_PAGE=50

# Historical backfill mode: 0 to only scan newly arriving emails,
# or N (e.g. 5) to backfill the most recent N historical emails upon first start
HISTORICAL_BACKFILL_LIMIT=0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

